# ==============================================================================
# MSG INCOMING - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8001

# Security & Multi-Tenant Authentication
SECRET_KEY=generate_a_super_secret_jwt_key_at_least_32_bytes_long!
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEFAULT_ADMIN_EMAIL=admin@quant.com
DEFAULT_ADMIN_PASSWORD=AdminPasswordSecure2026!

# PostgreSQL Database (Async via asyncpg)
POSTGRES_USER=admin
POSTGRES_PASSWORD=quant_secure_pwd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=msg_incoming_db
# Optional full URI override:
# DATABASE_URL=postgresql+asyncpg://admin:quant_secure_pwd@postgres:5432/msg_incoming_db

# ==============================================================================
# TELEGRAM / TELETHON MTPROTO CREDENTIALS
# ==============================================================================
# Telegram App Credentials obtained from https://my.telegram.org
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Optional Bot Token (if operating as MTProto Bot instead of user account)
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Session persistence
TELEGRAM_SESSION_NAME=msg_ingestor
TELEGRAM_SESSIONS_DIR=/app/sessions
# StringSession token (optional, useful for ephemeral or serverless containers)
# TELEGRAM_SESSION_STRING=1BJWap8wBu8...
TELEGRAM_AUTO_START=true

# ==============================================================================
# DOWNSTREAM TRADING BROKERS & QUANT ENGINE DISPATCH
# ==============================================================================
# URL of MetaTrader 5 Quant Server (signals intake)
BROKER_API_URL=http://metatrader5-quant-server:8000
BROKER_API_KEY=optional_secret_api_key
DISPATCH_TIMEOUT_SECONDS=5.0

# Optional URL of Rust web hub
RUST_APP_URL=http://rust-app:3000
